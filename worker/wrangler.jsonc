{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "driving-license-answer-checker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ATTEMPT_GUARD", "class_name": "AttemptGuard" }
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "driving-license-auth",
      "database_id": "8e50b2e5-3e9b-40e2-af86-a718895e6d4e",
      "migrations_dir": "./migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AttemptGuard"] }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://tihonovka.github.io,https://driving-license-answer-checker.driving-license-practice.workers.dev"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
